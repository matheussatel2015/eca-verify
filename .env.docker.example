# Optional Docker overrides for ECA Verify (copy to .env.docker — gitignored).
# Only needed to enable the signed verification proof (JWT ES256). If absent,
# the stack still runs and proof endpoints return 503.
#
# Generate an EC P-256 (prime256v1) PKCS8 key and base64-encode it (single line):
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt | base64 -w0
# Then set:
PROOF_PRIVATE_KEY_B64=
